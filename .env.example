# Google Calendar OAuth (Google Cloud Console > API 및 서비스 > 사용자 인증 정보 > OAuth 클라이언트 ID > 데스크톱 앱)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 조회할 캘린더 ID. 기본 캘린더는 primary
GOOGLE_CALENDAR_ID=primary

# Discord (Discord Developer Portal > Applications > 봇 생성 > 토큰 발급)
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
# channel 또는 dm
DISCORD_TARGET_TYPE=channel
# channel이면 채널 ID, dm이면 받을 사람의 유저 ID
DISCORD_TARGET_ID=

# 시간대 (기본값 Asia/Seoul)
TIMEZONE=Asia/Seoul

# 내일 일정/할 일/날씨를 미리 보내는 저녁 발송 시각 (HH:MM, 기본 21:00)
EVENING_SEND_TIME=21:00

# 기상청 날씨 (기상청 API 허브 https://apihub.kma.go.kr 가입 후 발급되는 인증키(authKey).
# 공공데이터포털 data.go.kr과는 다른 별개 시스템이니 주의. 휴대전화 인증이 되어 있어야 발급/사용 가능하다.)
KMA_SERVICE_KEY=
# 기상청 5km 격자 좌표(nx, ny). 아래 값은 인천 검단구 원당동 기준으로 이미 계산해둔 값.
# 다른 지역이면 https://www.weather.go.kr 등에서 조회하거나 위경도를 알려주면 변환해준다.
WEATHER_NX=55
WEATHER_NY=127
# 이 이상이면(%) 우산을 챙기라고 안내
UMBRELLA_POP_THRESHOLD=50
# 이 미만이면(%) 빨래를 널어도 된다고 안내
LAUNDRY_POP_THRESHOLD=30
